# Forge Admin Service

APP_ENV=development
HTTP_PORT=9010
LOG_LEVEL=debug

# Database (shared with grapery)
DB_DATABASE=grapery
DB_USERNAME=root
DB_PASSWORD=your_password
DB_ADDRESS=127.0.0.1:3306

# JWT (independent from grapery)
FORGE_JWT_SECRET=your-secure-random-secret-here

# CORS
ALLOW_ORIGINS=http://localhost:3000
