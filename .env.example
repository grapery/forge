# Forge Admin Service

FORGE_ENV=development
FORGE_HTTP_PORT=9010
FORGE_LOG_LEVEL=debug

# Database (shared with grapery)
DB_DATABASE=grapery
DB_USERNAME=root
DB_PASSWORD=your_password
DB_ADDRESS=127.0.0.1:3306

# JWT (independent from grapery)
FORGE_JWT_SECRET=your-secure-random-secret-here
FORGE_JWT_ACCESS_EXPIRY=24h
FORGE_JWT_REFRESH_EXPIRY=168h

# CORS（生产经 ngx 访问时填站点域名，逗号分隔）
FORGE_ALLOW_ORIGINS=http://localhost:3000,http://localhost:9010

# 前端构建（CI 默认 /forge，与 ngx、next basePath 一致）
# NEXT_PUBLIC_FORGE_API_URL=/forge
